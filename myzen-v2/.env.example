# Leave the Supabase values blank to run the portal in demo mode (bundled sample data).

NEXT_PUBLIC_SUPABASE_URL=
# Reserved for future client-side use; the portal does not need it yet.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. NEVER expose to the browser, never commit, never put on employee PCs.
SUPABASE_SERVICE_ROLE_KEY=

# Signs manager login cookies. Set a long random string when deploying or tunnelling.
SESSION_SECRET=
