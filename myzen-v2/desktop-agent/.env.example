# MyZenV2 Desktop Agent Environment Variables

# Supabase Configuration (optional - uses local storage if not provided)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Employee ID (set after first run or during installation)
EMPLOYEE_ID=

# Screenshot Configuration (OFF by default for privacy)
ENABLE_SCREENSHOTS=false
SCREENSHOT_INTERVAL_MINUTES=10
BLUR_SCREENSHOTS=true

# Activity Monitoring
IDLE_THRESHOLD_SECONDS=300
CHECK_INTERVAL_SECONDS=5
