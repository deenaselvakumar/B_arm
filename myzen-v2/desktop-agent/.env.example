# Only the PUBLIC anon key goes on employee PCs. NEVER put SUPABASE_SERVICE_ROLE_KEY here.
# Leave both blank to run in demo mode (data stays on this PC).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional
# AGENT_PORT=3001
# AGENT_TIMEZONE=Asia/Kolkata
# IDLE_THRESHOLD_SECONDS=120
# CHECK_INTERVAL_SECONDS=5
# SYNC_INTERVAL_SECONDS=30

# Screenshots are OFF. Capture needs all three gates (see README):
# ENABLE_SCREENSHOTS=true
# SCREENSHOT_TEAMS=AI/ML,Design
# SCREENSHOT_INTERVAL_MINUTES=10
