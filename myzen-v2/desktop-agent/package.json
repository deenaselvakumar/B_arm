{
  "name": "myzen-v2-agent",
  "version": "0.2.0",
  "description": "MyZenV2 desktop agent: employee login, punch in/out, breaks, log time, activity monitoring, Supabase sync",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:headless": "node src/headless.js",
    "simulate": "node src/headless.js --simulate --fast",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "B-Arm India",
  "license": "MIT",
  "dependencies": {
    "active-win": "^7.7.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "optionalDependencies": {
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "electron": "^27.1.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.barm.myzen-agent",
    "productName": "MyZen Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
